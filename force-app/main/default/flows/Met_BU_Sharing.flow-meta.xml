<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <customErrors>
        <name>Read_Group_Missing</name>
        <label>Read Group Missing</label>
        <locationX>440</locationX>
        <locationY>1100</locationY>
        <customErrorMessages>
            <errorMessage>Public group &quot;{!readGroupName}&quot; was not found, so this record can&apos;t be shared with the Business Unit.</errorMessage>
            <fieldSelection>Business_Unit__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Sharing_Error</name>
        <label>Sharing Error</label>
        <locationX>700</locationX>
        <locationY>650</locationY>
        <customErrorMessages>
            <errorMessage>Could not update Business Unit sharing: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>BU_Added_Or_Changed</name>
        <label>BU Added or Changed?</label>
        <locationX>182</locationX>
        <locationY>200</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>(1 AND 2) OR 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Business_Unit__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Business_Unit__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Old_BU_Share</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_BU</name>
        <label>Has BU?</label>
        <locationX>182</locationX>
        <locationY>500</locationY>
        <defaultConnectorLabel>BU Cleared</defaultConnectorLabel>
        <rules>
            <name>BU_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Business_Unit__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Read_Group</targetReference>
            </connector>
            <label>BU Set</label>
        </rules>
    </decisions>
    <decisions>
        <name>Old_Share_Found</name>
        <label>Old Share Found?</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Has_BU</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Old_Share_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Old_BU_Share</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Old_BU_Share</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Read_Group_Found</name>
        <label>Read Group Found?</label>
        <locationX>182</locationX>
        <locationY>950</locationY>
        <defaultConnector>
            <targetReference>Read_Group_Missing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Read_Group</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_BU_Share</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>When a Met record's Business Unit is set or changed, removes the previous BU's share and shares the record with the new BU's &quot;&lt;BU Name&gt; - Read&quot; public group. Only shares with the BU_Read__c reason are touched.</description>
    <environments>Default</environments>
    <formulas>
        <name>readGroupName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Business_Unit__r.Name} &amp; &quot; - Read&quot;</expression>
    </formulas>
    <interviewLabel>Met BU Sharing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Met BU Sharing</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_BU_Share</name>
        <label>Create BU Share</label>
        <locationX>182</locationX>
        <locationY>1100</locationY>
        <faultConnector>
            <targetReference>Sharing_Error</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>AccessLevel</field>
            <value>
                <stringValue>Read</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RowCause</field>
            <value>
                <stringValue>BU_Read__c</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UserOrGroupId</field>
            <value>
                <elementReference>Get_Read_Group.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Met__Share</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordDeletes>
        <description>Removes the old BU's share. Only BU_Read__c shares are fetched, so owner, manual and rule shares are never deleted.</description>
        <name>Delete_Old_BU_Share</name>
        <label>Delete Old BU Share</label>
        <locationX>50</locationX>
        <locationY>450</locationY>
        <connector>
            <targetReference>Has_BU</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Sharing_Error</targetReference>
        </faultConnector>
        <inputReference>Get_Old_BU_Share</inputReference>
    </recordDeletes>
    <recordLookups>
        <description>A record can only hold one BU share, but a collection is fetched so any stray duplicates are cleaned up too.</description>
        <name>Get_Old_BU_Share</name>
        <label>Get Old BU Share</label>
        <locationX>182</locationX>
        <locationY>275</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Old_Share_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Sharing_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>RowCause</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>BU_Read__c</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Met__Share</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Read_Group</name>
        <label>Get Read Group</label>
        <locationX>182</locationX>
        <locationY>800</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Read_Group_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Sharing_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>readGroupName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Regular</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>BU_Added_Or_Changed</targetReference>
        </connector>
        <object>Met__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
